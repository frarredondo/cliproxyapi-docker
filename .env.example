# Copy to .env and fill in the values. The .env file is git-ignored — never
# commit real keys.

# NOTE: upstream versions are not configured here. The major lines live at
# the top of the Makefile and the exact tags in cliproxy.lock; `make` keeps a
# managed block of CLIPROXY_*/KEEPER_* lines in your .env in sync so plain
# `docker compose` commands keep working. Do not set them by hand — see
# "Versioning" in the README.

# REQUIRED — client API key. Generate with:  openssl rand -hex 32
CLIPROXY_API_KEY=

# Listen port inside the container (also adjust the compose port mapping if changed)
CLIPROXY_PORT=8317

# Bind interface inside the container. Leave empty to bind all interfaces
# (required for the published port to work); restrict access via the compose
# port mapping (e.g. "127.0.0.1:8317:8317") instead.
CLIPROXY_HOST=

# Management API key — effectively REQUIRED: the usage keeper authenticates to
# the proxy's management API with it. Leave empty only if you remove the
# cpa-usage-keeper service. Generate with:  openssl rand -hex 32
CLIPROXY_MANAGEMENT_KEY=

# Allow management API access from non-localhost clients. Must be true for the
# usage keeper: it connects from the compose-internal network, which the proxy
# sees as non-localhost. This is safe here — the management port is still
# published on 127.0.0.1 only, and every call requires the key above.
CLIPROXY_ALLOW_REMOTE_MANAGEMENT=true

# REQUIRED — usage keeper dashboard login password. The cpa-usage-keeper
# container refuses to start until this is set (the proxy is unaffected).
# Generate with:  openssl rand -hex 32
KEEPER_LOGIN_PASSWORD=

# Logging
CLIPROXY_DEBUG=false
CLIPROXY_LOGGING_TO_FILE=true

# Container timezone
TZ=UTC
