# Copy to .env and fill in the values. The .env file is git-ignored — never
# commit real keys.

# NOTE: the upstream version is not configured here. The major line lives at
# the top of the Makefile and the exact tag in cliproxy.lock; `make` keeps a
# CLIPROXY_VERSION line in your .env in sync so plain `docker compose` commands
# keep working. Do not set it by hand — see "Versioning" in the README.

# REQUIRED — client API key. Generate with:  openssl rand -hex 32
CLIPROXY_API_KEY=

# Listen port inside the container (also adjust the compose port mapping if changed)
CLIPROXY_PORT=8317

# Bind interface inside the container. Leave empty to bind all interfaces
# (required for the published port to work); restrict access via the compose
# port mapping (e.g. "127.0.0.1:8317:8317") instead.
CLIPROXY_HOST=

# Management API key (leave empty to disable the management API / control panel).
# Generate with:  openssl rand -hex 32
CLIPROXY_MANAGEMENT_KEY=

# Allow management API access from non-localhost clients (keep false in production)
CLIPROXY_ALLOW_REMOTE_MANAGEMENT=false

# Logging
CLIPROXY_DEBUG=false
CLIPROXY_LOGGING_TO_FILE=true

# Container timezone
TZ=UTC
